# Salin ke .env.local (untuk Next.js) dan .env (untuk skrip). Jangan commit file .env*.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/polimedia
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/polimedia_test
# Folder penyimpanan lampiran (di luar /public, hanya diakses lewat endpoint ber-otorisasi)
UPLOAD_DIR=.data/uploads
# Set "true" bila aplikasi diakses lewat HTTPS (cookie Secure)
COOKIE_SECURE=false
